---
import UnitCard from './UnitCard.astro';
import type { Unit } from '../../lib/units';

interface Props {
  units: Unit[];
}
const { units } = Astro.props;
---

<ul class="grid">
  {
    units.map((u) => (
      <li>
        <UnitCard unit={u} />
      </li>
    ))
  }
</ul>

<script>
  import { load } from '../../lib/progress';

  // 各単元カードに「解けた」問題数を表示する
  const sync = () => {
    const p = load().problems;
    document.querySelectorAll<HTMLElement>('[data-progress]').forEach((el) => {
      const ids = el.dataset.progress!.split(' ');
      const solved = ids.filter((id) => p[id]?.state === 'solved').length;
      if (solved > 0) el.dataset.done = `${solved}/${ids.length} 解けた`;
      else delete el.dataset.done;
    });
  };
  sync();
  window.addEventListener('advmath:progress', sync);
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
