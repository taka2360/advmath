---
import { pad2, type Unit } from '../../lib/units';
import { unitUrl } from '../../lib/url';

interface Props {
  unit: Unit;
}
const { unit } = Astro.props;
const d = unit.data;
---

<a class="card" href={unitUrl(unit.id)} data-group={d.map.group}>
  <span class="top">
    <span class="num">{pad2(d.order)}</span>
    <span class="chip" data-type={d.outsideType}>{d.outsideType}</span>
  </span>
  <span class="title">{d.title}</span>
  <span class="hook">{d.hook}</span>
  <span class="meta">
    <span>{d.map.group}</span>
    <span>約 {d.minutes} 分</span>
    <span class="progress" data-progress={d.exercises.map((e) => e.id).join(' ')}>演習 {d.exercises.length} 問</span>
  </span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 18px 20px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s,
      box-shadow 0.15s;
  }

  .card::after {
    content: '';
    position: absolute;
    left: 20px;
    right: 20px;
    top: 0;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: var(--g);
  }

  .card[data-group='解析'] {
    --g: var(--vermilion);
  }

  .card[data-group='線形'] {
    --g: var(--accent);
  }

  .card[data-group='離散'] {
    --g: var(--green);
  }

  .card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-2px);
    }
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .num {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--g);
  }

  .title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.12rem;
    line-height: 1.45;
  }

  .hook {
    flex: 1;
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.7;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  .progress[data-done]::after {
    content: attr(data-done);
    margin-left: 6px;
    color: var(--green);
  }
</style>
